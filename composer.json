{
    "name": "perfexdev360/shared-features",
    "description": "Shared features resources package for perfexdev360",
    "type": "library",
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Perfexdev360\\SharedFeatures\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Perfexdev360\\SharedFeatures\\Providers\\SharedFeaturesServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
